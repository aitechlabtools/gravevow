 /* ── Bastión unificado (14/11): tarjetas de mercader con primer plano de medio pecho ── */
 .vtile { display: flex; flex-direction: column; min-height: 0; padding: 0; cursor: pointer; overflow: hidden; transition: filter .1s; }
 .vtile:hover { filter: brightness(1.15); }
+.vtile.vcard:hover { filter: none; }
 .vtile:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 2px; }
 .vtile-name { display: block; text-align: center; padding: 8px; font-size: clamp(15px, 1.15vw, 22px); letter-spacing: .08em; color: var(--color-parchment);
   background: linear-gradient(180deg, #26232c, #15131a); border-bottom: 2px solid #3a3741; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
