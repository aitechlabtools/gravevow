+
+/* ===== Fase 2 (maqueta): interior del mercader ===== */
+.vback{width:100%;min-height:48px;font-size:16px;font-family:var(--font-display);letter-spacing:.06em;white-space:nowrap}
+.vtabs{flex-wrap:nowrap}
+.vtabs-col{display:flex;flex-direction:column;gap:6px;width:100%}
+.vtabs-col button{display:flex;align-items:center;gap:12px;min-height:48px;padding:0 12px;background:var(--color-stone-800);border:2px solid var(--color-stone-600);color:var(--color-parchment);font-family:var(--font-display);font-size:16px;letter-spacing:.04em;text-align:left;cursor:pointer}
+.vtabs-col button:hover{background:var(--surface-hi)}
+.vtabs-col button[aria-selected=true]{background:var(--gold-fill);border-color:var(--gold-fill);color:#1a1205}
+.vtabs-col .vtab-lbl{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.vtabs-col .vtab-dot{margin-left:0}
+.vtabs-col button[aria-selected=true] .vtab-dot{color:#1a1205}
+.shop-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:6px}
+.shop-row{display:flex;align-items:center;gap:12px;padding:6px 12px 6px 6px;background:var(--color-stone-800);border:2px solid var(--color-stone-700);min-height:64px;cursor:pointer}
+.shop-row:hover{background:var(--surface-hi)}
+.shop-row.on{border-color:var(--color-gold)}
+.shop-row.locked .shop-ico,.shop-row.locked .shop-name,.shop-row.other .shop-ico{opacity:.5}
+.shop-name{font-size:16px}
+.shop-sub{font-size:14px;color:var(--color-stone-300)}
+.price-tag{display:inline-flex;align-items:center;gap:4px;font-family:var(--font-display);font-size:17px;color:var(--color-gold);white-space:nowrap}
+.price-tag.short{color:var(--danger-tx)}
+.shop-lock{display:inline-flex;align-items:center;gap:4px;font-size:13px;color:var(--color-stone-300);white-space:nowrap}
+.text-danger{color:var(--danger-tx)}
+@media (max-height:520px){
+  .shop-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:4px}
+  .shop-row{min-height:52px;gap:8px;padding:4px 8px 4px 4px}
+  .shop-row .shop-ico{width:40px;height:40px}
+  .shop-row .shop-ico img{width:32px;height:32px}
+  .shop-name{font-size:14px}
+  .shop-sub{font-size:13px}
+  .price-tag{font-size:15px}
+  .vtabs-col{gap:4px}
+  .vtabs-col button{min-height:44px;padding:0 8px;gap:8px;font-size:14px}
+}
